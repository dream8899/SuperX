{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoremix007.local/schemas/plan-1.0.json",
  "title": "SuperVideoMix Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "job_id",
    "state",
    "created_at",
    "input",
    "analysis",
    "preset",
    "operations",
    "operation_order",
    "conflict_checks",
    "preview",
    "encode",
    "expected",
    "output",
    "tool_versions",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "video-remix-plan"},
    "job_id": {"type": "string", "pattern": "^[a-f0-9]{20}$"},
    "state": {"const": "planned"},
    "created_at": {"type": "string", "format": "date-time"},
    "input": {"$ref": "#/$defs/media"},
    "analysis": {"type": "object"},
    "preset": {"enum": ["preserve", "vertical-social", "preview-fast"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    },
    "operation_order": {
      "type": "array",
      "items": {"type": "string"}
    },
    "conflict_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "status", "message"],
        "properties": {
          "type": {"type": "string"},
          "status": {"enum": ["clear", "needs_review"]},
          "message": {"type": "string"}
        }
      }
    },
    "preview": {
      "type": "object",
      "required": ["required", "status", "path"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "ready", "approved"]},
        "path": {"type": ["string", "null"]}
      }
    },
    "encode": {"type": "object"},
    "expected": {"type": "object"},
    "output": {
      "type": "object",
      "required": ["path", "overwrite"],
      "properties": {
        "path": {"type": "string"},
        "overwrite": {"const": false}
      }
    },
    "tool_versions": {"type": "object"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_key", "operation", "agent"],
      "properties": {
        "schema": {"const": "supermedia.lineage/v1"},
        "source_key": {"type": "string", "pattern": "^[a-z0-9-]+:.+$"},
        "source_creator": {"type": ["string", "null"]},
        "parent_asset_id": {"type": ["string", "null"]},
        "batch_id": {"type": ["string", "null"]},
        "recipe_id": {"type": ["string", "null"]},
        "operation": {"type": "string"},
        "agent": {"type": "string"}
      }
    },
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "media": {
      "type": "object",
      "required": ["path", "sha256", "size", "width", "height", "fps", "has_audio"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "duration": {"type": ["number", "null"], "minimum": 0},
        "width": {"type": ["integer", "null"]},
        "height": {"type": ["integer", "null"]},
        "fps": {"type": "string"},
        "has_audio": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "required": ["type", "mode", "params", "risk", "requires_preview", "approved"],
      "properties": {
        "type": {"type": "string"},
        "mode": {"type": "string"},
        "preset": {"type": ["string", "null"]},
        "preset_version": {"type": ["string", "null"]},
        "params": {"type": "object"},
        "risk": {"enum": ["low", "medium", "high"]},
        "requires_preview": {"type": "boolean"},
        "approved": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
